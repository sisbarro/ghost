# Optional local overrides. API keys can also be entered in GhostMail's API Keys screen.
APP_PASSWORD=change-this-password
FLASK_SECRET_KEY=replace-with-a-long-random-value
DEFAULT_SENDER_NAME=Ghost
DEFAULT_SENDER_EMAIL=sender@example.com

# Optional startup provider and credentials
EMAIL_PROVIDER=resend
RESEND_API_KEY=
ZEPTOMAIL_API_KEY=